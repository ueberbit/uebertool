<p>All options are optional and deep-merged with the defaults.</p>

{% embed code_block with { lang: 'ts', title: 'vite.config.ts' } %}{% block code %}{% verbatim %}
uebertool({
  url: 'http://localhost',
  ce: { prefix: 'mytheme' },
  breakpoints: { multipliers: ['1x', '2x'] },
  features: {
    twighmr: true,
    clearCache: 'drush cr',
  },
  baseTheme: 'stable9',
  themePackage: 'mytheme',
  vue: {},
  unimport: {},
  components: {},
})
{% endverbatim %}{% endblock %}{% endembed %}

<table>
  <thead><tr><th>Option</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>url</code></td><td><code>'http://localhost'</code></td><td>Origin of the dev server used in the dev <code>libraries.yml</code>. The port comes from <code>server.port</code> (default 5173). If the option is not set, <code>UEBERTOOL_URL</code> or <code>DDEV_PRIMARY_URL</code> is used.</td></tr>
    <tr><td><code>ce.prefix</code></td><td>theme name</td><td>Prefix of <a href="{{ path('uebertool_docs_pages.page', { slug: 'custom-element-loader' }) }}">custom element</a> tag names.</td></tr>
    <tr><td><code>breakpoints.multipliers</code></td><td><code>['1x', '2x']</code></td><td>Multipliers of every generated <a href="{{ path('uebertool_docs_pages.page', { slug: 'breakpoints' }) }}">breakpoint</a>.</td></tr>
    <tr><td><code>features.twighmr</code></td><td><code>true</code></td><td>Enables <a href="{{ path('uebertool_docs_pages.page', { slug: 'twig-hmr' }) }}">Twig HMR</a>.</td></tr>
    <tr><td><code>features.clearCache</code></td><td><code>'drush cr'</code></td><td>Command run after <a href="{{ path('uebertool_docs_pages.page', { slug: 'restart' }) }}">files were added or removed</a>. <code>false</code> disables it.</td></tr>
    <tr><td><code>baseTheme</code></td><td><code>'stable9'</code></td><td>Base theme of the generated <a href="{{ path('uebertool_docs_pages.page', { slug: 'theme-info' }) }}">dist theme</a>.</td></tr>
    <tr><td><code>themePackage</code></td><td>theme name</td><td><code>package</code> of the dist theme.</td></tr>
    <tr><td><code>vue</code></td><td>custom elements = tags with a dash</td><td>Options for <code>@vitejs/plugin-vue</code>.</td></tr>
    <tr><td><code>unimport</code></td><td>see <a href="{{ path('uebertool_docs_pages.page', { slug: 'auto-imports' }) }}">Auto-imports</a></td><td>Options for <code>unimport</code>.</td></tr>
    <tr><td><code>components</code></td><td>see <a href="{{ path('uebertool_docs_pages.page', { slug: 'auto-imports' }) }}">Auto-imports</a></td><td>Options for <code>unplugin-vue-components</code>.</td></tr>
  </tbody>
</table>

{% embed aside with { type: 'caution', title: 'No effect' } %}
  {% block content %}
    <p><code>features.resetTheme</code> and <code>experimental</code> are part of the options type but currently not used by any plugin.</p>
  {% endblock %}
{% endembed %}

<h2>Environment variables</h2>
<table>
  <thead><tr><th>Variable</th><th>Effect</th></tr></thead>
  <tbody>
    <tr><td><code>UEBERTOOL_URL</code></td><td>Dev server origin, if <code>url</code> is not set.</td></tr>
    <tr><td><code>DDEV_PRIMARY_URL</code></td><td>Same, set automatically inside DDEV. An <code>https://</code> URL switches HMR to <code>wss</code>.</td></tr>
  </tbody>
</table>
