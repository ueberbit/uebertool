{% extends "block.html.twig" %}
{#
/**
 * @file
 * Theme override for a branding block.
 *
 * Each branding element variable (logo, name, slogan) is only available if
 * enabled in the block configuration.
 * In case the logo is a local SVG (which is strongly recommended), it will be
 * rendered inline.
 *
 * Available variables:
 * - site_logo: Logo for site as defined in Appearance or theme settings.
 * - site_logo_svg: The logo's SVG markup, if the logo is a local SVG file.
 * - site_name: Name for site as defined in Site information settings.
 * - site_slogan: Slogan for site as defined in Site information settings.
 */
#}

{% set attributes = attributes.removeAttribute('id') %}

{% block content %}
  {% if site_logo %}
    <a href="{{ path('<front>') }}" rel="home" class="text-white logo">
    {% if site_logo_svg %}
      {{ site_logo_svg }}
    {% else %}
      <img src="{{ site_logo }}" alt="{{ 'Home'|t }}" />
    {% endif %}
    </a>
  {% endif %}
  {% if site_name %}
    <a href="{{ path('<front>') }}" rel="home">{{ site_name }}</a>
  {% endif %}
  {{ site_slogan }}
{% endblock %}
