{
  "name": "@ueberbit/vite-plugin-drupal",
  "type": "module",
  "version": "0.8.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberbit/uebertool.git",
    "directory": "packages/vite-plugin-drupal"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./composables": {
      "types": "./dist/composables.d.mts",
      "import": "./dist/composables.mjs"
    },
    "./ApiCustomElements": {
      "types": "./dist/ce/ApiCustomElements.d.mts",
      "import": "./dist/ce/ApiCustomElements.mjs"
    },
    "./types/*": {
      "types": "./types/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "uebertool": "bin/uebertool.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "static",
    "types"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "obuild",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@headlessui/vue": "^1.7.0",
    "@tailwindcss/forms": "^0.5.7",
    "@types/alpinejs": "^3.13.10",
    "@types/js-cookie": "^3.0.6",
    "alpinejs": "^3.13.10",
    "lit": "^3.1.3",
    "morphdom": "^2.7.2",
    "pinia": ">=2.0.0",
    "preact": "^11.2.0",
    "tailwindcss": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "@headlessui/vue": {
      "optional": true
    },
    "pinia": {
      "optional": true
    },
    "preact": {
      "optional": true
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "@ueberbit/tailwind": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/shared": "catalog:",
    "@vueuse/core": "catalog:",
    "typescript": "catalog:",
    "unimport": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "defu": "catalog:",
    "fs-extra": "catalog:",
    "magic-string": "catalog:",
    "rollup": "catalog:",
    "tinyglobby": "catalog:",
    "web-component-analyzer": "catalog:",
    "yaml": "catalog:"
