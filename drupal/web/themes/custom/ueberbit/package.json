{
  "type": "module",
  "version": "0.0.1-beta.2",
  "private": true,
  "engines": {
    "node": "^22.0.0",
    "pnpm": "^10.0.0"
  },
  "scripts": {
    "dev": "uebertool && vite",
    "build": "uebertool && vite build",
    "dev:storybook": "start-storybook -p 5174 --config-dir .storybook --ci",
    "build:storybook": "node ./.storybook/build.mjs",
    "build:wca:vscode": "wca \"./templates/**/*.ce.{ts,tsx,vue}\" --outFiles .uebertool/vscode.html-custom-data.json --format vscode",
    "build:wca:ce": "wca \"./templates/**/*.ce.{ts,tsx,vue}\" --outFiles .uebertool/custom-elements.json"
  },
  "dependencies": {
    "lit": "3.3.2",
    "morphdom": "^2.7.8",
    "pinia": "^3.0.4",
    "swiper": "^12.1.3",
    "typescript": "^6.0.2",
    "web-component-analyzer": "^2.0.0"
  },
  "devDependencies": {
    "@ueberbit/vite-plugin-drupal": "workspace:*",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0"
  }
}
