<?php

/**
 * @file
 * Provides Photoswipe settings.
 */

use Drupal\Core\Field\FormatterInterface;
use Drupal\Core\Template\Attribute;
use Drupal\file\FileInterface;
use Drupal\image\Entity\ImageStyle;

/**
 * Implements hook_theme().
 */
function uebertool_pswp_theme(): array {
  return [
    'field__pswp' => [
      'base hook' => 'field',
    ],
  ];
}

/**
 * Implements hook_field_formatter_third_party_settings_form().
 */
function uebertool_pswp_field_formatter_third_party_settings_form(FormatterInterface $plugin): array {
  if (!in_array($plugin->getPluginId(), [
    'image',
    'image_sizes_extras_formatter',
  ])) {
    return [];
  }

  $imageStyles = image_style_options(FALSE);
  $settings['uebertool_pswp'] = [];

  $settings['uebertool_pswp']['pswp'] = [
    '#title' => t('Enable Photoswipe'),
    '#description' => t('Photoswipe opens a Lightbox when clicking on an image.'),
    '#type' => 'checkbox',
    '#default_value' => $plugin->getThirdPartySetting('uebertool_pswp', 'pswp'),
  ];

  $settings['uebertool_pswp']['pswp_style'] = [
    '#title' => t('PhotoSwipe Image style'),
    '#type' => 'select',
    '#default_value' => $plugin->getThirdPartySetting('uebertool_pswp', 'pswp_style'),
    '#empty_option' => t('None (original image)'),
    '#options' => $imageStyles,
    '#description' => t('Select Image Style used for Photoswipe.'),
  ];

  return $settings['uebertool_pswp'];
}

/**
 * Implements hook_preprocess_field().
 *
 * Adds the link target and the dimensions Photoswipe needs to every item.
 * The Photoswipe library itself has to be attached by the theme.
 */
function uebertool_pswp_preprocess_field(array &$vars): void {
  $config = $vars['element']['#third_party_settings']['uebertool_pswp'] ?? [];

  if (empty($config['pswp'])) {
    return;
  }

  $imageStyle = empty($config['pswp_style']) ? NULL : ImageStyle::load($config['pswp_style']);

  foreach ($vars['items'] as &$item) {
    $imageItem = $item['content']['#item'] ?? NULL;
    $file = $imageItem?->entity ?? $item['content']['#entity'] ?? NULL;

    if (!$file instanceof FileInterface) {
      continue;
    }

    $uri = $file->getFileUri();

    // Image fields store the dimensions of the original image. Only read the
    // file when they are missing.
    $dimensions = [
      'width' => $imageItem?->width ?? NULL,
      'height' => $imageItem?->height ?? NULL,
    ];
    if (!$dimensions['width'] || !$dimensions['height']) {
      $image = \Drupal::service('image.factory')->get($uri);
      $dimensions = [
        'width' => $image->getWidth(),
        'height' => $image->getHeight(),
      ];
    }

    $url = NULL;
    if ($imageStyle) {
      $styled = $dimensions;
      $imageStyle->transformDimensions($styled, $uri);
      // Fall back to the original image if the style's output size is
      // unknown, because Photoswipe needs the dimensions.
      if (!empty($styled['width']) && !empty($styled['height'])) {
        $url = $imageStyle->buildUrl($uri);
        $dimensions = $styled;
      }
    }
    $url ??= \Drupal::service('file_url_generator')->generateAbsoluteString($uri);

    $item['attributes'] = new Attribute([
      'data-pswp-width' => $dimensions['width'],
      'data-pswp-height' => $dimensions['height'],
      'href' => $url,
      'target' => '_blank',
    ]);
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 *
 * Adds the Photoswipe suggestions on top of the existing ones, so themes can
 * still override them per field (field--pswp--FIELD-NAME.html.twig).
 */
function uebertool_pswp_theme_suggestions_field_alter(array &$suggestions, array $variables): void {
  if (empty($variables['element']['#third_party_settings']['uebertool_pswp']['pswp'])) {
    return;
  }

  $suggestions[] = 'field__pswp';
  if (isset($variables['element']['#field_name'])) {
    $suggestions[] = 'field__pswp__' . $variables['element']['#field_name'];
  }
}
