{#
/**
 * @file
 * Details Item SDC Component.
 *
 * @slot summary - The summary slot.
 * @slot content - The content slot.
 *
 * @prop {boolean} open - Details is open.
 * @prop {boolean} disabled - Details is disabled.
 *
 * Available variables:
 * - attributes - Drupal attributes.
 * - summary_attributes - Summary attributes.
 *
 */
#}

{%
  set attributes = attributes
  .setAttribute('open', open)
  .setAttribute('disabled', disabled)
  .setAttribute('name', name)
%}

{% set _template %}
  <div {{ base_attributes }} part="base">
    <header
      aria-controls="content"
      part="summary"
      tabindex="0"
      role="button"
      {{ summary_attributes }}
      >
      <slot name="summary"></slot>
    </header>
    <div part="body">
      <div part="content" id="content" {{ content_attributes }}>
        <slot></slot>
      </div>
    </div>
  </div>
  <link rel="stylesheet" href="{{ '/' ~ componentMetadata.path ~ '/' ~ componentMetadata.machineName ~ '-shadow.css' }}">
{% endset %}

{% set _slot %}
  <div slot="summary" {{ summary_attributes }}>
    {% block summary %}{{ summary }}{% endblock %}
  </div>
  {% block content %}
    {{ content }}
  {% endblock %}
{% endset %}

<ueberbit-details {{ attributes }}>
  <template shadowrootmode="open">
    {{ _template }}
  </template>
  {{ _slot }}
</ueberbit-details>
