<p><a href="https://alpinejs.dev">Alpine.js</a> is <a href="{{ path('uebertool_docs_pages.page', { slug: 'auto-imports' }) }}">auto-imported</a>. Use <code>Alpine</code> in any script and the import is added for you; the runtime is split into its own <code>alpine.runtime</code> chunk. If you never use it, it's not in your bundle.</p>

{% include preview with { demo: 'alpine', title: 'Alpine store' } %}

<h2>Register stores, then start</h2>
<p>Alpine is not started for you. Register stores, data and plugins first, then call <code>Alpine.start()</code>:</p>
{% embed code_block with { lang: 'ts', title: 'js/main.ts' } %}{% block code %}{% verbatim %}
/**
 * Global entrypoint. `Alpine` is auto-imported, `Drupal` is a global.
 */
Alpine.store('darkMode', {
  on: false,
  toggle() {
    this.on = !this.on
  },
})

Alpine.start()

export {}
{% endverbatim %}{% endblock %}{% endembed %}

